
<template>
    <ConfirmDialog />
  <div class="business-dashboard hr-dashboard">
    <div class="columns is-multiline">
      <div class="column is-8">
        <div class="columns is-multiline">
          <div class="column is-12">
            <div class="illustration-header-2 large-screen">
              <div class="header-image">
                <img src="/@src/assets/illustrations/dashboards/lifestyle/da.png" alt=""
                  style="max-width:84%; margin-left: 2rem; margin-bottom: 1rem;" />
              </div>
              <div class="header-meta">
                <h3 style="color:white"><i class="fas fa-id-card" aria-hidden="true"></i> Dashboard
                  Registrasi</h3>
                <p>
                  Selamat Datang , {{ userLogin.pegawai.namaLengkap }}
                </p>
                <VControl>
                  <Multiselect mode="single" v-model="item.filterRuangan" :options="d_Ruangan" class="f-text"
                    placeholder="Filter ruangan" :searchable="true" autocomplete="off"
                    @select="changeRuang(item.filterRuangan)" />
                </VControl>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="column is-4">
        <VCard>
          <div class="columns is-multiline">
            <div class="column is-12">
              <h3 class="title is-5 mb-2">Rekap
                <VTag @click="modalFilter = true" color="danger" rounded elevated class="is-pulled-right is-clickable">{{
                  H.formatDateNoTime(item.filterDate)
                }} <i class="fas fa-filter ml-3" aria-hidden="true"></i></VTag>
              </h3>
            </div>
          </div>
          <div class="columns is-multiline">
            <div class="column is-6">
              <CardCountRev icon="/images/simrs/icon-reservasi.png" straight :total="item.c_reservasi"
                label="Reservasi" />
            </div>
            <div class="column is-6">
              <CardCountRev icon="/images/simrs/icon-registrasi.png" straight :total="item.c_registrasi"
                label="Pasien Teregistrasi" />
            </div>
            <div class="column is-6">
              <CardCountRev icon="/images/simrs/icon-antrian.png" straight :total="item.c_antrian"
                label="Antrian Pasien" />
            </div>
            <div class="column is-6">
              <CardCountRev icon="/images/simrs/icon-dilayani.png" straight :total="item.c_dilayani"
                label="Pasien Dilayani" />
            </div>
          </div>
        </VCard>
      </div>
    </div>

    <div class="columns is-multiline">
      <div class="column is-3" v-if="!HIDE_FILTER">
        <div class="column is-12 p-0">
          <VCard radius="rounded">
            <div class="columns is-multiline">
              <div class="column is-12">
                <VIconButton circle class="mr-2 is-pulled-right" icon="fas fa-expand-arrows-alt" raised bold
                  v-tooltip.bubble="'Perkecil Tampilan '" @click="HIDE_FILTER = true">
                </VIconButton>
              </div>
              <div class="column is-12 jobs-dashboard">
                <div class="jobs-dashboard-wrapper">
                  <div class="main-container">
                    <div class="search-type">
                      <div class=" job-time">
                        <div class="job-time-title mb-2"> Pembiayaan</div>
                        <div class="job-wrapper">
                          <div class="type-container" v-if="dataCount.length" v-for="items of dataCount">
                            <VCheckbox alue-true="job-type-1" :label="items.kelompokpasien" color="primary" paddingless
                              :value="items.id" v-model="checkboxKel[items.id]" class="m-0 p-0"
                              @change="clickKelompok()" />
                            <span class="job-number"
                              style="background-color:var(--placeholder) ;font-weight: bold ;color: var(--danger);">{{
                                items.jmlkp
                              }}</span>
                          </div>
                        <VPlaceholderPage v-else-if="dataCount.length === 0" :title="H.assets().notFound"
                          small>
                          <template #image>
                            <img class="light-image" :src="H.assets().iconNotFound_rev" alt="" size="50%" />
                            <img class="dark-image" src="/@src/assets/illustrations/placeholders/search-4-dark.svg" alt="" />
                          </template>
                        </VPlaceholderPage>

                          <VPlaceloadText :lines="8" class="mt-2" v-else />


                        </div>
                      </div>
                      <div class=" job-time mt-3">
                        <div class="job-time-title mb-2"> Instalasi</div>
                        <div class="job-wrapper">
                          <div class="type-container" v-if="dataDept.length" v-for="items of dataDept">
                            <VCheckbox alue-true="job-type-1" :label="items.namadepartemen" color="primary" paddingless
                              :value="items.id" v-model="checkboxInst[items.id]" class="m-0 p-0"
                              @change="clickInstalasi()" />
                            <span class="job-number"
                              style="background-color:var(--placeholder) ;font-weight: bold;color: var(--danger);">{{
                                items.jmldp
                              }}</span>
                          </div>
                          <VPlaceloadText :lines="8" class="mt-2" v-else />
                        </div>

                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </VCard>
        </div>
        <div class="column is-12 p-0 mt-5">
          <VCard class="p-0">
            <div class="column c-title pt-2 mb-2">
              <label style="font-weight:bold">Jadwal Dokter</label>
            </div>

            <div class="column p-2" style="height: 21rem;overflow: auto;">
              <VCard v-for="(data) in dataDokter" class="mb-2">
                <div class="columns is-multiline">
                  <VAvatar style="margin-top: 13px;" size="small" picture="/images/avatars/svg/user2.svg" color="primary"
                    squared bordered />
                  <div class="column pb-0 pt-0">
                    <p style="font-size: smaller;font-weight: 500;color: black;">{{ data.namalengkap }}</p>
                    <span style="font-size: 0.9rem;"> <i aria-hidden="true" class="iconify" data-icon="feather:clock"
                        style="padding-right: 3px;"></i> {{ data.jammulai }} s.d {{
                          data.jamakhir }}</span>
                    <VTag color="info" label="Tag Label" rounded elevated>{{ data.hari }}</VTag>
                  </div>
                </div>
              </VCard>
            </div>
          </VCard>
        </div>
      </div>
      <!-- <div class="column is-3"></div> -->
      <div class="column" :class="HIDE_FILTER ? 'is-12' : 'is-9'">
        <div class="columns is-multiline">
          <div class="column is-12">
            <VCard radius="rounded">
              <div class="columns is-multiline">
                <div class="column is-4">
                  <VField label="Periode">
                    <VControl class="prime-auto">
                      <Calendar :locale="'id'" :dateFormat="H.dateTimeFormat().prime.date" inputId="range" v-model="item.qPeriode" selectionMode="range" :manualInput="false"
                        :disabled="!item.qAktif" class="w-100" :showIcon="true" :hideOnRangeSelection="true" />
                    </VControl>
                  </VField>
                </div>
                <!-- <div class="column is-3">
                  <VField label="No RM">
                    <VControl icon="fas fa-id-card" fullwidth>
                      <VInput type="text" placeholder="No RM" autocomplete="off" v-model="item.qnocm" class="is-rounded"
                        v-on:keyup.enter="cari()" />
                    </VControl>
                  </VField>
                </div> -->
                <div class="column is-6" v-if="!isReservasi">
                  <VField label="Cari Pasien">
                    <VControl icon="fas fa-id-card" fullwidth>
                      <VInput type="text" placeholder="Nama Pasien, No RM, No Registrasi, BPJS, Atau NIK"
                        autocomplete="off" v-model="item.search" class="is-rounded" v-on:keyup.enter="cari()" />
                    </VControl>
                  </VField>
                </div>
                <div class="column is-6" v-if="isReservasi">
                  <VField label="Cari Pasien Reservasi">
                    <VControl icon="fas fa-id-card" fullwidth>
                      <VInput type="text" placeholder="Nama Pasien, No Reservasi, No RM, BPJS, Atau NIK"
                        autocomplete="off" v-model="item.qsearch" class="is-rounded"
                        v-on:keyup.enter="fetchReservasi()" />
                    </VControl>
                  </VField>
                </div>
                <!-- <div class="column is-3">
                  <VField label="Nama">
                    <VControl icon="fas fa-user" fullwidth>
                      <VInput type="text" placeholder="Nama" autocomplete="off" v-model="item.qnamapasien"
                        class="is-rounded" v-on:keyup.enter="cari()" />
                    </VControl>
                  </VField>
                </div> -->
                <div class="column is-2 mt-5">
                  <VIconButton type="button" color="success" class="is-rounded" rounded raised icon="fas fa-search"
                    @click="cari()" :loading="isLoading">

                  </VIconButton>
                  <VIconButton type="button" color="info" class="is-rounded ml-1" raised icon="fas fa-filter"
                    @click="HIDE_FILTER = false">
                  </VIconButton>
                </div>

              </div>
            </VCard>
          </div>
          <div class="column is-12">
            <VCard radius="rounded" v-if="IS_REGISTRASI">
              <div class="columns column">
                <h3 class="title is-5 mb-2 mr-1">Pasien </h3>
                <span>{{ '(' + (ds_PASIEN.total != undefined ? ds_PASIEN.total : 0) + ' totals)' }}
                </span>
              </div>
              <div class="columns is-multiline">
                <div class="column is-12">
                  <div class="columns">
                    <div class="column is-3">
                      <VField v-slot="{ id }" class="is-icon-select mt-1">
                        <VControl>
                          <Multiselect v-model="selectView" :attrs="{ id }" placeholder="Select View" label="name"
                            :options="d_View" :searchable="true" track-by="name" mode="single"
                            @select="changeView(selectView)" autocomplete="off">
                            <template #singlelabel="{ value }">
                              <div class="multiselect-single-label">
                                <div class="select-label-icon-wrap">
                                  <i :class="value.icon"></i>
                                </div>
                                <span class="select-label-text">
                                  {{ value.name }}
                                </span>
                              </div>
                            </template>
                            <template #option="{ option }">
                              <div class="select-option-icon-wrap">
                                <i :class="option.icon"></i>
                              </div>
                              <span class="select-option-text">
                                {{ option.name }}
                              </span>
                            </template>
                          </Multiselect>
                        </VControl>
                      </VField>
                    </div>
                    <div class="column is-3">
                      <VField class="h-hidden-mobile">
                        <VControl>
                          <VSwitchBlock v-model="item.qAktif" label="Pasien Aktif" color="danger"
                            @change="changeSwitch(item.qAktif)" />
                        </VControl>
                      </VField>
                    </div>
                    <div class="column is-6 mt-4">
                      <VField class="h-hidden-mobile">
                        <RouterLink :to="{ name: 'module-registrasi-pasien-lama', }">
                          <VIconButton class="ml-3 is-pulled-right" type="button" color="info" rounded circle raised
                            icon="fas fa-users" v-tooltip.bubble="'Pasien Lama'">
                          </VIconButton>
                        </RouterLink>
                        <VButton class="ml-3 is-pulled-right" type="button" color="info" rounded raised
                          icon="fas fa-long-arrow-alt-right" @click="pasienBaru()">
                          Pasien Baru
                        </VButton>
                        <VButton class="ml-3 is-pulled-right" type="button" color="info" rounded outlined raised
                          icon="fas fa-address-book" :loading="isLoading" @click="changeReservasi(false)"> Daftar
                          Reservasi
                        </VButton>
                      </VField>
                    </div>
                  </div>

                  <div class="user-grid user-grid-v2" v-if="selectView == 'grid'">
                    <div class="columns is-multiline" v-if="ds_PASIEN.loading">
                      <!--Grid item-->
                      <div v-for="key in 8" :key="key" class="column is-4">
                        <div class="grid-item">
                          <VPlaceloadAvatar size="big" centered class="mb-2" />

                          <VPlaceloadText class="mb-4" width="80%" :lines="3" last-line-width="60%" centered />

                          <div class="people">
                            <VPlaceloadAvatar size="small" class="mx-1" />
                            <VPlaceloadAvatar size="small" class="mx-1" />
                            <VPlaceloadAvatar size="small" class="mx-1" />
                            <VPlaceloadAvatar size="small" class="mx-1" />
                          </div>

                          <VButtons>
                            <VButton placeload="100%" dark-outlined>loading ...</VButton>
                            <VButton placeload="100%" dark-outlined>loading ...</VButton>
                          </VButtons>
                        </div>
                      </div>
                    </div>

                    <VPlaceholderPage v-else-if="ds_PASIEN.length === 0" :title="H.assets().notFound"
