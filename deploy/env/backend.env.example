# =============================================================================
# deploy/env/backend.env.example — contoh .env untuk backend/ (Laravel 8)
#
# Cara pakai:
#   copy deploy/env/backend.env.example backend/.env      (Windows)
#   cp    deploy/env/backend.env.example backend/.env     (Linux/macOS)
#   lalu sesuaikan nilai DB_* dan jalankan:
#     cd backend && php artisan key:generate
#
# CATATAN: berkas backend/.env TIDAK ikut ter-commit (lihat backend/.gitignore).
# =============================================================================

APP_NAME=SIMRS
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost/simrs

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database utama -----------------------------------------------------------
# Aplikasi ini aslinya memakai PostgreSQL (lihat sql.txt).
#   DB_CONNECTION=pgsql  DB_PORT=5432
# Untuk memakai hasil konversi MySQL (sql_mysql.sql):
#   DB_CONNECTION=mysql  DB_PORT=3306
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rsud_malangbong
DB_USERNAME=root
DB_PASSWORD=

# --- MongoDB (OPSIONAL) -------------------------------------------------------
# Dipakai hanya oleh sebagian fitur log/EMR. Kosongkan bila tidak ada MongoDB;
# aplikasi tetap berjalan (koneksi dibuat saat dipakai).
DATABASE_URL_MONGO=
DB_HOST_MONGO=127.0.0.1
DB_PORT_MONGO=27017
DB_DATABASE_MONGO=simrs
DB_USERNAME_MONGO=
DB_PASSWORD_MONGO=

# --- JWT (WAJIB) --------------------------------------------------------------
# Nilai harus sama di semua environment; mengubahnya membuat token lama tidak valid.
JWT_KEY=TRANSINDO
JWT_ALG=HS512
JWT_EXPIRED_MINUTE_BPJS=10
IS_PASSWORD_HASH=true

# --- Captcha (OPSIONAL) -------------------------------------------------------
# Login hanya meminta captcha bila tabel settingdatafixed_m.namafield='enabledCaptcha'
# bernilai 'true'.
CAPTCHA_SECRETKEY=6LeFaW4pAAAAAFKqmDcmKMw4K537gjEdhcESA7em

# --- Cache / Session / Queue --------------------------------------------------
# 'file' = tanpa dependency tambahan. Untuk produksi bisa diganti redis.
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# --- Mail (OPSIONAL) ----------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=simrs@localhost
MAIL_FROM_NAME="${APP_NAME}"

# --- Redis (OPSIONAL, hanya bila CACHE_DRIVER/SESSION_DRIVER=redis) -----------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
