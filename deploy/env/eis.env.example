# =============================================================================
# deploy/env/eis.env.example — contoh .env untuk eis/ (Laravel 7, penampil EMR/EIS)
#
# Cara pakai:
#   copy deploy/env/eis.env.example eis/.env      (Windows)
#   cp    deploy/env/eis.env.example eis/.env     (Linux/macOS)
#   lalu: cd eis && php artisan key:generate
#
# PENTING: eis/ memakai MySQL (bukan PostgreSQL seperti backend/) dan membaca
# database yang SAMA (nama db di bawah). Berkas eis/.env tidak ikut ter-commit.
# =============================================================================

APP_NAME=EIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/simrs/eis

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rsud_malangbong
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=simrs@localhost
MAIL_FROM_NAME="${APP_NAME}"
