# =============================================================================
# deploy/env/frontend-v2.env.example — contoh .env untuk frontend-v2/ (Vue 3 + Vite)
#
# Cara pakai:
#   copy deploy\env\frontend-v2.env.example frontend-v2\.env      (Windows)
#   cp    deploy/env/frontend-v2.env.example frontend-v2/.env     (Linux/macOS)
#
# CATATAN: semua variabel harus berawalan VITE_ agar terbaca di kode browser.
# Berkas frontend-v2/.env TIDAK ikut ter-commit (lihat frontend-v2/.gitignore).
# =============================================================================

# Alamat API backend. Tiga pilihan:
#   1) Satu pintu /simrs (DIREKOMENDASIKAN) — relatif, otomatis mengikuti host
#      dan tidak kena CORS:
#         VITE_API_BASE_URL=/simrs/service/
#   2) Akses langsung ke Laravel (port 8000) — perlu CORS (sudah '*' default):
#         VITE_API_BASE_URL=http://localhost:8000/service/
#   3) Nama domain produksi:
#         VITE_API_BASE_URL=https://simrs.contoh.go.id/service/
VITE_API_BASE_URL=/simrs/service/

# Identitas tampilan
VITE_PROJECT=SIMRS
VITE_FOOTER=Transmedic
VITE_FOOTER_BY=RS Umum Daerah

# Base path aplikasi (dipakai vite.config.ts).
#   - `npm run dev`  → jalankan: VITE_BASE_PATH=/simrs/ npm run dev
#   - Biarkan kosong/`/` bila aplikasi diakses langsung di root (http://localhost:2222/)
# Untuk build: VITE_BASE_PATH=/simrs/ npm run build
VITE_BASE_PATH=/simrs/

# Opsional: lewati plugin optimasi gambar (vite-imagetools/sharp & vite-plugin-imagemin)
# yang membutuhkan binary native. Set 'true' bila `npm install` gagal pada sharp/imagemin.
# SKIP_IMAGE_PLUGINS=false

# Captcha reCAPTCHA/Turnstile (opsional; dikosongkan bila tidak dipakai)
VITE_CAPTCHA_SITEKEY=

# Peta pada dashboard (opsional)
VITE_MAPBOX_ACCESS_TOKEN=
